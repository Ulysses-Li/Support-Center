      "insert_features": {
        "source": {
          "printed_page": 144,
          "pdf_page": 3
        },
        "general": [
          "U type insert is fully ground for reducing the cutting resistance during the cutting, best choice for long shank cutter.",
          "H type with high positive rake angle, shape edge."
        ],
        "grade_notes": [
          {
            "grade_code": "NC5072",
            "label": "NC5072",
            "notes": [
              "High rigidity, special edge honing, resistance of impact during milling operation.",
              "Special chip breaker design for high removal rate.",
              "P40 tougher grade for smooth cutting, good for all kinds of steel."
            ]
          },
          {
            "grade_code": "NC2032",
            "label": "U-NC2032",
            "notes": [
              "High rigidity, special edge honing, resistance of impact during milling operation.",
              "For all kinds of steel from < 50 HRC, carbon steel, alloy steel, cast iron, aluminum and non-ferrous metal."
            ]
          },
          {
            "grade_code": "NC2033",
            "label": "H-NC2033",
            "notes": [
              "Sharp cutting edge and high positive rake angle, good for finishing milling and surface roughness.",
              "Re 0.5 and Re1.0 for your option.",
              "Sutiable for all kinds of steel."
            ]
          },
          {
            "grade_code": "NC9031",
            "label": "H-NC9031",
            "notes": [
              "Sharp cutting edge and high positive rake angle, low friction coefficient for non-ferrous metal.",
              "Good for Al, Al-alloy, Copper, Copper alloy and Non-Ferrous metal."
            ]
          },
          {
