  "common_calculation_plan": {
    "metric_rpm": {
      "expression": "S=1000*Vc/(pi*D)",
      "inputs": {
        "Vc": "m/min",
        "D": "mm drill/effective cutting diameter"
      },
      "output": "rpm",
      "source": {
        "printed_page": 141,
        "pdf_page": 6,
        "original_pdf_page": 14
      },
      "scope_note": "Metric arithmetic applied after selecting the Super Drill material, body depth class and application factor."
    },
    "metric_feed": {
      "expression": "F=S*f",
      "inputs": {
        "S": "rpm",
        "f": "mm/rev"
      },
      "output": "mm/min",
      "source": {
        "printed_page": 141,
        "pdf_page": 6,
        "original_pdf_page": 14
      }
    },
    "inch_catalog": {
      "printed_expressions": [
        "S=(3.82*SFM)/d",
        "SFM=Vc(m/min)*3.28",
        "f=IPR=inch/rev",
        "F=IPM=RPM*f/25.4"
