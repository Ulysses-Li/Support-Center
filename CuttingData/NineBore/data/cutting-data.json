  "formulas": [
    {
      "quantity": "spindle_speed",
      "symbol": "S",
      "expression": "Vc * 1000 / (PI * D)",
      "unit": "rpm",
      "status": "catalog",
      "diameter_basis_zh_tw": "D為搪孔切削直徑，後續UI應對應客戶目標孔徑，不是刀柄或刀桿外徑。",
