      {
        "step": 2,
        "action": "以3mm六角扳手鬆開M6 pre-load screw，勿將螺絲拆出"
      },
      {
        "step": 3,
        "action": "取出原刀桿並插入新刀桿"
      },
      {
        "step": 4,
        "action": "先鎖M6預壓螺絲",
        "recommended_torque_Nm": {
          "min": 0.9,
          "max": 1
        }
      },
      {
        "step": 5,
        "action": "使用刀具預調儀量測並調整所需搪孔直徑"
      },
      {
        "step": 6,
        "action": "最後鎖M8固定螺絲",
        "recommended_torque_Nm": {
          "min": 8,
          "max": 9
        }
      }
    ],
    "table_torque_reference": {
